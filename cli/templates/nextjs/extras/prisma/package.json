{
  "name": "devstart-template",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:generate": "varlock run -- bunx --bun prisma generate",
    "db:migrate": "varlock run -- bunx --bun prisma migrate dev",
    "db:migrate:deploy": "varlock run -- bunx --bun prisma migrate deploy",
    "db:push": "varlock run -- bunx --bun prisma db push",
    "db:studio": "varlock run -- bunx --bun prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "postcss": "^8",
    "prisma": "^6.16.2",
    "prisma-json-types-generator": "^4.1.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
